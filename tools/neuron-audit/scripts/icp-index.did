type Tokens = record { e8s : nat64 };
type Operation = variant {
  Approve : record { fee : Tokens; from : text; allowance : Tokens; expires_at : opt record { timestamp_nanos : nat64 }; spender : text };
  Burn : record { from : text; amount : Tokens; spender : opt text };
  Mint : record { to : text; amount : Tokens };
  Transfer : record { to : text; fee : Tokens; from : text; amount : Tokens; spender : opt text };
  TransferFrom : record { to : text; fee : Tokens; from : text; amount : Tokens; spender : text };
};
type Transaction = record { memo : nat64; icrc1_memo : opt blob; operation : Operation; created_at_time : opt record { timestamp_nanos : nat64 }; timestamp : opt record { timestamp_nanos : nat64 } };
type TransactionWithId = record { id : nat64; transaction : Transaction };
type Result = variant { Ok : record { balance : nat64; transactions : vec TransactionWithId; oldest_tx_id : opt nat64 }; Err : record { message : text } };
service : { get_account_identifier_transactions : (record { max_results : nat64; start : opt nat64; account_identifier : text }) -> (Result) query };
